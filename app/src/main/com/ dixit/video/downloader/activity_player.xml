<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#02070F">
    <androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="match_parent" android:keepScreenOn="true" app:show_buffering="when_playing" app:resize_mode="fit" app:use_controller="true" />
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top" android:padding="10dp" android:orientation="horizontal" android:background="#B3020A15" android:gravity="center_vertical">
        <TextView android:id="@+id/playerInfo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nature Documentary" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" />
        <Button android:id="@+id/lockButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Lock" android:textSize="10sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:background="#D9020A15" android:paddingTop="8dp">
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="44dp" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal">
            <Button android:id="@+id/audioButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Audio Track" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/speedButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="1.0x" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/aspectButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Aspect" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/brightnessButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Brightness" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/avSyncButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="A/V Sync" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/lyricsButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Subtitles" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/audioFxButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Equalizer" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/pipButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="PiP" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/abButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="A-B" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/frameButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Frame" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/screenshotButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Shot" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/infoButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Info" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/decoderButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Decoder" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/seekButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Seek" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
            <Button android:id="@+id/loopButton" android:layout_width="wrap_content" android:layout_height="40dp" android:text="Loop" android:textSize="9sp" android:textColor="#FFFFFF" android:backgroundTint="#172C4B" />
        </LinearLayout></HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
